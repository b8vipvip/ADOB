# Local plugin testing: stdio. Public/self-hosted service: http.
AUTODEVOPS_TRANSPORT=stdio
AUTODEVOPS_HOST=127.0.0.1
AUTODEVOPS_PORT=8787

# Fine-grained GitHub token for the private MVP. Never commit the real value.
GITHUB_TOKEN=

# Optional bearer secret for the HTTP MVP. Public release will use OAuth 2.1.
MCP_SHARED_SECRET=

# Comma-separated Host header allow-list for HTTP mode.
AUTODEVOPS_ALLOWED_HOSTS=127.0.0.1,localhost

# JSON array. See ../examples/projects.json.
AUTODEVOPS_PROJECTS_JSON=[{"id":"sumeme","name":"SuMeMe","repo":"b8vipvip/sumeme","productionBranch":"main","statusBranch":"ops-status","statusPath":"status/status.json","workflows":{"deploy":"deploy-production.yml","diagnose":"diagnose-production.yml","rollback":"rollback-production.yml"}}]
